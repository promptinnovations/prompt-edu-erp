# PROMPT EDU ERP — environment variables
# Copy this file to .env.local and fill in values as needed.
# See docs/SETUP.md for the full walkthrough.

# --- Local development (no external accounts needed) -----------------------
# Leave everything below commented out to run entirely on the embedded local
# Postgres (PGlite). Uncomment PGLITE_DATA_DIR only if you want the local
# database stored somewhere other than the default ./database/.pglite-data.
# PGLITE_DATA_DIR=./database/.pglite-data

# Set to "true" ONLY for local development without Supabase configured.
# Hard-blocked by services/auth/auth-service.ts when NODE_ENV=production
# unless explicitly set — never use this with real institution data.
# ALLOW_DEV_AUTH=true

# --- Real Postgres (Supabase, Neon, or self-hosted) -------------------------
# When DATABASE_URL is set, services/db/client.ts automatically uses it
# instead of the local embedded database (ARCHITECTURE.md §V).
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Supabase Auth / Storage --------------------------------------------------
# When these two are set, services/auth/auth-service.ts automatically
# switches from DevAuthProvider to SupabaseAuthProvider, AND
# services/storage/storage-provider.ts automatically switches from
# LocalFileProvider to SupabaseStorageProvider (bucket "institution-files",
# auto-created on first use). Leave unset to keep files on local disk under
# ./.local-storage/ (dev/test fallback, never used for real institution data
# in production — see docs/SETUP.md).
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only — never expose to the client (§X.1)

# --- Distributed rate limiting (Upstash Redis) ---------------------------------
# When these two are set, services/rate-limit/rate-limiter.ts automatically
# switches from the in-memory limiter to Upstash Redis (REST-based, so it
# works from Next.js Edge middleware), so the login/import/mark-entry limits
# are enforced across every server instance instead of resetting per
# process. Only matters once you're running more than one instance — leave
# unset for local dev / a single-instance deployment. See docs/SETUP.md.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# --- Email (SMTP) -------------------------------------------------------------
# When SMTP_HOST + SMTP_PORT are set, services/notification/email-provider.ts
# automatically switches from ConsoleEmailProvider to SmtpEmailProvider
# (real delivery via nodemailer). Leave unset to keep emails logged to the
# console only (notifications.status='skipped' for the email channel).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=xxxx
# MAIL_FROM=no-reply@your-institution.example
