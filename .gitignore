# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local embedded Postgres data (PGlite) — see docs/SETUP.md
/database/.pglite-data/
/database/.e2e-pglite-data/

# playwright e2e — see docs/SETUP.md
/playwright-report/
/test-results/
/blob-report/

# local file storage (LocalFileProvider dev/test fallback) — see docs/SETUP.md
/.local-storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
